---
import logo from '../../assets/logo-ownitaly.png';

const currentPath = Astro.url.pathname;

const navLinks = [
  { name: "Home", href: "/" },
  { name: "About Us", href: "/about" },
  { name: "Service", href: "/service" },
  { name: "All You Need to Know", href: "/faq" },
  { name: "Own Italy Blog", href: "/blog" },
];
---

<header
  x-data="{ mobileOpen: false, scrolled: false }"
  x-init="scrolled = window.scrollY > 30"
  @scroll.window="scrolled = (window.scrollY > 30)"
  :class="scrolled || mobileOpen
    ? 'bg-white border-b border-stone-200 shadow-sm h-16 lg:h-20 text-[#141414]'
    : 'bg-transparent border-b border-white/15 h-24 lg:h-28 text-white'"
  class="fixed top-0 inset-x-0 z-50 w-full transition-all duration-300 flex items-center"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="flex justify-between items-center">
      
      <!-- Brand Logo: altezza statica fissa sull'HTML per evitare flash al caricamento -->
<a href="/" class="flex items-center shrink-0">
  <img
    src={logo.src}
    alt="OWN ITALY — Property Finder in Italy"
    width={logo.width}
    height={logo.height}
    :class="scrolled || mobileOpen
      ? '!h-8 lg:!h-10 brightness-100 invert-0'
      : 'brightness-0 invert'"
    class="h-10 lg:h-12 w-auto max-h-12 object-contain transition-all duration-300"
  />
</a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center space-x-8 text-sm font-medium">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href;
          return (
            <a
              href={link.href}
              :class={isActive
                ? "scrolled ? 'text-[#9E7B56] border-[#9E7B56]' : 'text-[#DFC4A6] border-[#DFC4A6]'"
                : "scrolled ? 'text-[#141414] border-transparent hover:text-[#9E7B56]' : 'text-white/95 border-transparent hover:text-[#DFC4A6]'"}
              class="transition-colors duration-300 py-1.5 border-b-2"
            >
              {link.name}
            </a>
          );
        })}
      </nav>

      <!-- Desktop CTA -->
      <div class="hidden lg:flex items-center">
        <a
          href="/contact"
          :class="scrolled
            ? 'bg-[#141414] text-white hover:bg-[#9E7B56] py-2.5 px-5'
            : 'bg-white text-[#141414] hover:bg-[#9E7B56] hover:text-white py-3.5 px-6'"
          class="text-xs uppercase tracking-widest font-semibold transition-all duration-300"
        >
          Contact Us
        </a>
      </div>

      <!-- Mobile Hamburger -->
      <button
        type="button"
        @click="mobileOpen = !mobileOpen"
        :class="scrolled || mobileOpen ? 'text-[#141414]' : 'text-white'"
        class="lg:hidden p-2 transition-colors"
        aria-label="Toggle Menu"
      >
        <svg x-show="!mobileOpen" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg x-show="mobileOpen" x-cloak class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div
    x-show="mobileOpen"
    x-cloak
    class="lg:hidden fixed inset-x-0 top-16 bg-white border-b border-stone-200 shadow-xl px-6 py-8 space-y-5 text-[#141414]"
  >
    <div class="space-y-3 font-medium text-base">
      {navLinks.map((link) => (
        <a href={link.href} @click="mobileOpen = false" class="block py-1.5 hover:text-[#9E7B56]">
          {link.name}
        </a>
      ))}
    </div>
    <div class="pt-4 border-t border-stone-100">
      <a
        href="/contact"
        @click="mobileOpen = false"
        class="block w-full text-center bg-[#141414] text-white text-xs uppercase tracking-widest font-semibold py-4"
      >
        Contact Us
      </a>
    </div>
  </div>
</header>